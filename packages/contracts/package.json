{
  "name": "@ensforge/contracts",
  "version": "0.6.1",
  "description": "Type-safe contract ABIs, deployment addresses, and interfaces for ENS",
  "keywords": [
    "abi",
    "contracts",
    "ens",
    "ethereum",
    "typescript",
    "viem"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "workspace-source": "./src/internal.ts",
      "default": "./dist/internal.js"
    },
    "./shared": {
      "workspace-source": "./src/shared/index.ts",
      "default": "./dist/shared.js"
    },
    "./v1": {
      "workspace-source": "./src/v1/index.ts",
      "default": "./dist/v1.js"
    },
    "./v2": {
      "workspace-source": "./src/v2/index.ts",
      "default": "./dist/v2.js"
    },
    "./v2/experimental/hca": {
      "workspace-source": "./src/v2/experimental/hca/index.ts",
      "default": "./dist/v2/experimental/hca.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./internal": "./dist/internal.js",
      "./shared": "./dist/shared.js",
      "./v1": "./dist/v1.js",
      "./v2": "./dist/v2.js",
      "./v2/experimental/hca": "./dist/v2/experimental/hca.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:report": "node ../../scripts/api-report.mjs index v1 v2 shared v2/experimental/hca",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "verify": "node ../../scripts/lint-jsdoc.mjs src/index.ts src/v1/index.ts src/v2/index.ts src/shared/index.ts src/v2/experimental/hca/index.ts && node ../../scripts/api-report.mjs --check index v1 v2 shared v2/experimental/hca && typedoc"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ensforge/test-harness": "workspace:*",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "viem": "^2.57.0"
  }
}

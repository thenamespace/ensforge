{
  "name": "@ensforge/contracts",
  "version": "0.6.1",
  "description": "Type-safe contract ABIs, deployment addresses, and interfaces for ENS",
  "keywords": [
    "abi",
    "contracts",
    "deployments",
    "ens",
    "ethereum",
    "typescript",
    "viem"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "workspace-source": "./src/shared/index.ts",
      "default": "./dist/shared/index.js"
    },
    "./v1": {
      "workspace-source": "./src/v1/index.ts",
      "default": "./dist/v1/index.js"
    },
    "./v2": {
      "workspace-source": "./src/v2/index.ts",
      "default": "./dist/v2/index.js"
    },
    "./v2/experimental/hca": {
      "workspace-source": "./src/v2/experimental/hca/index.ts",
      "default": "./dist/v2/experimental/hca/index.js"
    },
    "./internal/*": {
      "workspace-source": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./shared": "./dist/shared/index.js",
      "./v1": "./dist/v1/index.js",
      "./v2": "./dist/v2/index.js",
      "./v2/experimental/hca": "./dist/v2/experimental/hca/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:report": "ensforge-dev api-report",
    "build": "ensforge-dev build",
    "dev": "ensforge-dev build --watch",
    "lint": "oxlint -c ../../.config/oxlint.config.ts --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "typecheck": "tsc --noEmit",
    "verify": "ensforge-dev verify"
  },
  "devDependencies": {
    "@ensforge/tools": "workspace:*",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "viem": "^2.57.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "ensforge": {
    "api": [
      ".",
      "./v1",
      "./v2",
      "./shared",
      "./v2/experimental/hca"
    ]
  }
}

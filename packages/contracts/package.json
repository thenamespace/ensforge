{
  "name": "@ensforge/contracts",
  "version": "0.4.0",
  "description": "Type-safe contract ABIs, deployment addresses, and interfaces for ENS",
  "keywords": [
    "abi",
    "contracts",
    "ens",
    "ethereum",
    "typescript",
    "viem"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./deployments": {
      "workspace-source": "./src/deployments/index.ts",
      "default": "./dist/deployments.js"
    },
    "./resolver-profiles": {
      "workspace-source": "./src/shared/resolver-profiles/index.ts",
      "default": "./dist/resolver-profiles.js"
    },
    "./shared": {
      "workspace-source": "./src/shared/index.ts",
      "default": "./dist/shared.js"
    },
    "./v1": {
      "workspace-source": "./src/v1/index.ts",
      "default": "./dist/v1.js"
    },
    "./v2": {
      "workspace-source": "./src/v2/index.ts",
      "default": "./dist/v2.js"
    },
    "./v2/experimental/hca": {
      "workspace-source": "./src/v2/experimental/hca/index.ts",
      "default": "./dist/v2/experimental/hca.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./deployments": "./dist/deployments.js",
      "./resolver-profiles": "./dist/resolver-profiles.js",
      "./shared": "./dist/shared.js",
      "./v1": "./dist/v1.js",
      "./v2": "./dist/v2.js",
      "./v2/experimental/hca": "./dist/v2/experimental/hca.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "catalog:"
  }
}

{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "customConditions": ["workspace-source"],
    "types": ["node"],
    "rootDir": ".",
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        },
        "keyPatterns": [{ "target": "service", "pattern": "package-identifier" }],
        "allowedUnstableApis": ["@ensforge/sdk", "effect/crypto"],
        "allowedExperimentalApis": [
          "@ensforge/contracts/namespaces/durin",
          "@ensforge/contracts/deployments/namespace-types",
          "@ensforge/contracts/v2/experimental/hca/standalone-hca-factory-interface#standaloneHcaFactoryV2InterfaceAbi"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts"]
}

{
  "name": "@ensforge/sdk",
  "version": "0.6.1",
  "description": "Type-safe actions and utilities for ENS",
  "keywords": [
    "effect",
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "workspace-source": "./src/actions/index.ts",
      "default": "./dist/actions/index.js"
    },
    "./effect": {
      "workspace-source": "./src/effect.ts",
      "default": "./dist/effect.js"
    },
    "./extension": {
      "workspace-source": "./src/extension.ts",
      "default": "./dist/extension.js"
    },
    "./indexer": {
      "workspace-source": "./src/indexer/index.ts",
      "default": "./dist/indexer/index.js"
    },
    "./wagmi": {
      "workspace-source": "./src/wagmi/index.ts",
      "default": "./dist/wagmi/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./actions": "./dist/actions/index.js",
      "./effect": "./dist/effect.js",
      "./extension": "./dist/extension.js",
      "./indexer": "./dist/indexer/index.js",
      "./wagmi": "./dist/wagmi/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:report": "ensforge-dev api-report",
    "build": "ensforge-dev build",
    "dev": "ensforge-dev build --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "verify": "ensforge-dev verify",
    "codegen": "ensforge-dev codegen",
    "openapi": "ensforge-dev openapi"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "catalog:",
    "@ensdomains/content-hash": "catalog:",
    "@ensforge/contracts": "workspace:*",
    "cborg": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ensforge/test-harness": "workspace:*",
    "@ensforge/tools": "workspace:*",
    "viem": "catalog:",
    "wagmi": "catalog:",
    "wagmi-v2": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "viem": "^2.57.0",
    "wagmi": ">=2.14.0 <4"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "ensforge": {
    "api": [
      ".",
      "./effect",
      "./indexer",
      "./wagmi"
    ],
    "effectFree": [
      ".",
      "./actions",
      "./indexer",
      "./wagmi"
    ],
    "codegen": "sdk",
    "openapi": true
  }
}

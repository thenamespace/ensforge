{
  "name": "@ensforge/sdk",
  "version": "0.4.0",
  "description": "A type-safe TypeScript SDK for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./batch": {
      "workspace-source": "./src/entrypoints/batch.ts",
      "default": "./dist/batch.js"
    },
    "./capabilities": {
      "workspace-source": "./src/entrypoints/capabilities.ts",
      "default": "./dist/capabilities.js"
    },
    "./dns": {
      "workspace-source": "./src/entrypoints/dns.ts",
      "default": "./dist/dns.js"
    },
    "./events": {
      "workspace-source": "./src/entrypoints/events.ts",
      "default": "./dist/events.js"
    },
    "./hca": {
      "workspace-source": "./src/entrypoints/hca.ts",
      "default": "./dist/hca.js"
    },
    "./hca/admin": {
      "workspace-source": "./src/entrypoints/hca-admin.ts",
      "default": "./dist/hca/admin.js"
    },
    "./indexer": {
      "workspace-source": "./src/entrypoints/indexer.ts",
      "default": "./dist/indexer.js"
    },
    "./migration": {
      "workspace-source": "./src/entrypoints/migration.ts",
      "default": "./dist/migration.js"
    },
    "./name": {
      "workspace-source": "./src/entrypoints/name.ts",
      "default": "./dist/name.js"
    },
    "./ownership": {
      "workspace-source": "./src/entrypoints/ownership.ts",
      "default": "./dist/ownership.js"
    },
    "./permissions": {
      "workspace-source": "./src/entrypoints/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./records": {
      "workspace-source": "./src/entrypoints/records.ts",
      "default": "./dist/records.js"
    },
    "./registration": {
      "workspace-source": "./src/entrypoints/registration.ts",
      "default": "./dist/registration.js"
    },
    "./resolution": {
      "workspace-source": "./src/entrypoints/resolution.ts",
      "default": "./dist/resolution.js"
    },
    "./reverse": {
      "workspace-source": "./src/entrypoints/reverse.ts",
      "default": "./dist/reverse.js"
    },
    "./subnames": {
      "workspace-source": "./src/entrypoints/subnames.ts",
      "default": "./dist/subnames.js"
    },
    "./wagmi": {
      "workspace-source": "./src/wagmi.ts",
      "default": "./dist/wagmi.js"
    },
    "./wrapping": {
      "workspace-source": "./src/entrypoints/wrapping.ts",
      "default": "./dist/wrapping.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./batch": "./dist/batch.js",
      "./capabilities": "./dist/capabilities.js",
      "./dns": "./dist/dns.js",
      "./events": "./dist/events.js",
      "./hca": "./dist/hca.js",
      "./hca/admin": "./dist/hca/admin.js",
      "./indexer": "./dist/indexer.js",
      "./migration": "./dist/migration.js",
      "./name": "./dist/name.js",
      "./ownership": "./dist/ownership.js",
      "./permissions": "./dist/permissions.js",
      "./records": "./dist/records.js",
      "./registration": "./dist/registration.js",
      "./resolution": "./dist/resolution.js",
      "./reverse": "./dist/reverse.js",
      "./subnames": "./dist/subnames.js",
      "./wagmi": "./dist/wagmi.js",
      "./wrapping": "./dist/wrapping.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensforge/core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "viem": "^2.56.0",
    "wagmi": ">=2.19.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  }
}

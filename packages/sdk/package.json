{
  "name": "@ensforge/sdk",
  "version": "0.6.1",
  "description": "A type-safe TypeScript SDK for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./wagmi": {
      "workspace-source": "./src/wagmi.ts",
      "default": "./dist/wagmi.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./wagmi": "./dist/wagmi.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensforge/core": "workspace:*"
  },
  "devDependencies": {
    "viem": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "viem": "^2.57.0",
    "wagmi": "^3.7.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  }
}

{
  "name": "@ensforge/sdk",
  "version": "0.6.1",
  "description": "Type-safe actions and utilities for ENS",
  "keywords": [
    "effect",
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "workspace-source": "./src/actions/index.ts",
      "default": "./dist/actions/index.js"
    },
    "./effect": {
      "workspace-source": "./src/effect.ts",
      "default": "./dist/effect.js"
    },
    "./extension": {
      "workspace-source": "./src/extension.ts",
      "default": "./dist/extension.js"
    },
    "./indexer": {
      "workspace-source": "./src/indexer/index.ts",
      "default": "./dist/indexer/index.js"
    },
    "./wagmi": {
      "workspace-source": "./src/wagmi/index.ts",
      "default": "./dist/wagmi/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./actions": "./dist/actions/index.js",
      "./effect": "./dist/effect.js",
      "./extension": "./dist/extension.js",
      "./indexer": "./dist/indexer/index.js",
      "./wagmi": "./dist/wagmi/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:report": "node ../../scripts/api-report.mjs index effect indexer wagmi",
    "build": "node ../../scripts/build-package.mjs",
    "codegen": "node scripts/codegen/main.ts",
    "codegen:check": "node scripts/codegen/main.ts --check",
    "indexer:openapi": "node scripts/indexer-openapi.ts",
    "dev": "node ../../scripts/build-package.mjs --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p test",
    "verify": "pnpm codegen:check && node ../../scripts/lint-jsdoc.mjs src/index.ts src/effect.ts src/indexer/index.ts src/wagmi/index.ts && node ../../scripts/api-report.mjs --check index effect indexer wagmi && node ../../scripts/check-dist-types.mjs index actions indexer wagmi --consumer scripts/fixtures/consumer.ts && node scripts/indexer-openapi.ts check && node ../../tools/typedoc/run.mjs && node ../../scripts/check-examples.mjs scripts/fixtures/example-globals.ts"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "catalog:",
    "@ensdomains/content-hash": "catalog:",
    "@ensforge/contracts": "workspace:*",
    "cborg": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ensforge/test-harness": "workspace:*",
    "@ensforge/tool-typedoc": "workspace:*",
    "viem": "catalog:",
    "wagmi": "catalog:",
    "wagmi-v2": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "viem": "^2.57.0",
    "wagmi": ">=2.14.0 <4"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}

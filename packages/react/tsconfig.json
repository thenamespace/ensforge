{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": ".",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

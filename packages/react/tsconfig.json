{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": ".",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        },
        "keyPatterns": [{ "target": "service", "pattern": "package-identifier" }],
        "allowedUnstableApis": ["@ensforge/react", "@effect/atom-react", "effect/reactivity"]
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

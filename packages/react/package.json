{
  "name": "@ensforge/react",
  "version": "0.6.1",
  "description": "Reactive React hooks for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "hooks",
    "react",
    "sdk",
    "typescript",
    "viem",
    "wagmi"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./atoms": {
      "workspace-source": "./src/atoms/index.ts",
      "default": "./dist/atoms.js"
    },
    "./cache": {
      "workspace-source": "./src/cache/index.ts",
      "default": "./dist/cache.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./atoms": "./dist/atoms.js",
      "./cache": "./dist/cache.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@ensforge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "react": "^19.2.0",
    "scheduler": ">=0.25.0 <0.29.0",
    "viem": "^2.57.0",
    "wagmi": "^3.7.0"
  }
}

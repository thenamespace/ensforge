{
  "name": "@ensforge/react",
  "version": "0.4.0",
  "description": "Reactive React hooks for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "hooks",
    "react",
    "sdk",
    "typescript",
    "viem",
    "wagmi"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./atoms": {
      "workspace-source": "./src/atoms/index.ts",
      "default": "./dist/atoms.js"
    },
    "./cache": {
      "workspace-source": "./src/cache/index.ts",
      "default": "./dist/cache.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./atoms": "./dist/atoms.js",
      "./cache": "./dist/cache.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@ensforge/core": "workspace:*",
    "@ensforge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "react": ">=19.0.0 <20.0.0",
    "scheduler": ">=0.25.0 <0.28.0",
    "viem": "^2.56.0",
    "wagmi": ">=2.19.0 <4.0.0"
  }
}

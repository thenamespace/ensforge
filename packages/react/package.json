{
  "name": "@ensforge/react",
  "version": "0.6.1",
  "description": "Effect Atom hooks and atoms for ENS in React",
  "keywords": [
    "effect",
    "effect-atom",
    "ens",
    "ethereum",
    "hooks",
    "react",
    "ssr",
    "viem",
    "wagmi"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./atoms": {
      "workspace-source": "./src/atoms/index.ts",
      "default": "./dist/atoms/index.js"
    },
    "./server": {
      "workspace-source": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./internal/*": {
      "workspace-source": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./atoms": "./dist/atoms/index.js",
      "./server": "./dist/server/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "ensforge-dev build",
    "dev": "ensforge-dev build --watch",
    "lint": "oxlint -c ../../.config/oxlint.config.ts --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "typecheck": "tsc --noEmit",
    "api:report": "ensforge-dev api-report",
    "verify": "ensforge-dev verify"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@ensforge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@ensforge/tools": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "scheduler": "catalog:",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "react": "^19.0.0",
    "scheduler": ">=0.25.0 <0.29.0",
    "viem": "^2.57.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "ensforge": {
    "api": [
      ".",
      "./atoms",
      "./server"
    ]
  }
}

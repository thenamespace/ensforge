{
  "name": "@ensforge/core",
  "version": "0.4.0",
  "description": "Type-safe actions and utilities for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./batch": {
      "workspace-source": "./src/actions/batch/index.ts",
      "default": "./dist/batch.js"
    },
    "./capabilities": {
      "workspace-source": "./src/actions/capabilities/index.ts",
      "default": "./dist/capabilities.js"
    },
    "./dns": {
      "workspace-source": "./src/actions/dns/index.ts",
      "default": "./dist/dns.js"
    },
    "./events": {
      "workspace-source": "./src/actions/events/index.ts",
      "default": "./dist/events.js"
    },
    "./hca": {
      "workspace-source": "./src/actions/hca/index.ts",
      "default": "./dist/hca.js"
    },
    "./hca/admin": {
      "workspace-source": "./src/actions/hca/admin/index.ts",
      "default": "./dist/hca/admin.js"
    },
    "./indexer": {
      "workspace-source": "./src/actions/indexer/index.ts",
      "default": "./dist/indexer.js"
    },
    "./indexer/history": {
      "workspace-source": "./src/actions/indexer/history/index.ts",
      "default": "./dist/indexer/history.js"
    },
    "./indexer/names": {
      "workspace-source": "./src/actions/indexer/names/index.ts",
      "default": "./dist/indexer/names.js"
    },
    "./indexer/records": {
      "workspace-source": "./src/actions/indexer/records/index.ts",
      "default": "./dist/indexer/records.js"
    },
    "./indexer/registrations": {
      "workspace-source": "./src/actions/indexer/registrations/index.ts",
      "default": "./dist/indexer/registrations.js"
    },
    "./indexer/registries": {
      "workspace-source": "./src/actions/indexer/registries/index.ts",
      "default": "./dist/indexer/registries.js"
    },
    "./indexer/resolvers": {
      "workspace-source": "./src/actions/indexer/resolvers/index.ts",
      "default": "./dist/indexer/resolvers.js"
    },
    "./migration": {
      "workspace-source": "./src/actions/migration/index.ts",
      "default": "./dist/migration.js"
    },
    "./name": {
      "workspace-source": "./src/actions/name/index.ts",
      "default": "./dist/name.js"
    },
    "./ownership": {
      "workspace-source": "./src/actions/ownership/index.ts",
      "default": "./dist/ownership.js"
    },
    "./permissions": {
      "workspace-source": "./src/actions/permissions/index.ts",
      "default": "./dist/permissions.js"
    },
    "./records": {
      "workspace-source": "./src/actions/records/index.ts",
      "default": "./dist/records.js"
    },
    "./registration": {
      "workspace-source": "./src/actions/registration/index.ts",
      "default": "./dist/registration.js"
    },
    "./resolution": {
      "workspace-source": "./src/actions/resolution/index.ts",
      "default": "./dist/resolution.js"
    },
    "./reverse": {
      "workspace-source": "./src/actions/reverse/index.ts",
      "default": "./dist/reverse.js"
    },
    "./storage": {
      "workspace-source": "./src/storage/index.ts",
      "default": "./dist/storage.js"
    },
    "./storage/browser": {
      "workspace-source": "./src/storage/browser.ts",
      "default": "./dist/storage/browser.js"
    },
    "./subnames": {
      "workspace-source": "./src/actions/subnames/index.ts",
      "default": "./dist/subnames.js"
    },
    "./wagmi": {
      "workspace-source": "./src/wagmi/index.ts",
      "default": "./dist/wagmi.js"
    },
    "./wrapping": {
      "workspace-source": "./src/actions/wrapping/index.ts",
      "default": "./dist/wrapping.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "workspace-source": "./src/testing/index.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./batch": "./dist/batch.js",
      "./capabilities": "./dist/capabilities.js",
      "./dns": "./dist/dns.js",
      "./events": "./dist/events.js",
      "./hca": "./dist/hca.js",
      "./hca/admin": "./dist/hca/admin.js",
      "./indexer": "./dist/indexer.js",
      "./indexer/history": "./dist/indexer/history.js",
      "./indexer/names": "./dist/indexer/names.js",
      "./indexer/records": "./dist/indexer/records.js",
      "./indexer/registrations": "./dist/indexer/registrations.js",
      "./indexer/registries": "./dist/indexer/registries.js",
      "./indexer/resolvers": "./dist/indexer/resolvers.js",
      "./migration": "./dist/migration.js",
      "./name": "./dist/name.js",
      "./ownership": "./dist/ownership.js",
      "./permissions": "./dist/permissions.js",
      "./records": "./dist/records.js",
      "./registration": "./dist/registration.js",
      "./resolution": "./dist/resolution.js",
      "./reverse": "./dist/reverse.js",
      "./storage": "./dist/storage.js",
      "./storage/browser": "./dist/storage/browser.js",
      "./subnames": "./dist/subnames.js",
      "./wagmi": "./dist/wagmi.js",
      "./wrapping": "./dist/wrapping.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "bench": "vitest bench --run bench",
    "codegen:indexer": "graphql-codegen --config codegen.indexer.ts",
    "codegen:indexer:check": "pnpm codegen:indexer && git diff --exit-code -- graphql/indexer src/internal/indexer/generated",
    "codegen:indexer:watch": "graphql-codegen --config codegen.indexer.ts --watch",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./testing",
    "prepack": "pnpm build",
    "schema:indexer:refresh": "node scripts/refresh-indexer-schemas.mjs",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live:mainnet": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.live-mainnet.config.ts",
    "test:live:sepolia": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.live-sepolia.config.ts",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "pnpm codegen:indexer:check && tsc --noEmit"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "catalog:",
    "@ensdomains/content-hash": "catalog:",
    "@ensforge/contracts": "workspace:*",
    "cborg": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "graphql": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112",
    "viem": "^2.56.0",
    "wagmi": ">=2.19.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  }
}

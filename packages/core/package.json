{
  "name": "@ensforge/core",
  "version": "0.6.1",
  "description": "Type-safe actions and utilities for ENS",
  "keywords": [
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "workspace-source": "./src/actions/index.ts",
      "default": "./dist/actions.js"
    },
    "./effect": {
      "workspace-source": "./src/effect.ts",
      "default": "./dist/effect.js"
    },
    "./legacy": {
      "workspace-source": "./src/legacy/index.ts",
      "default": "./dist/legacy.js"
    },
    "./legacy/batch": {
      "workspace-source": "./src/legacy/actions/batch/index.ts",
      "default": "./dist/legacy/batch.js"
    },
    "./legacy/capabilities": {
      "workspace-source": "./src/legacy/actions/capabilities/index.ts",
      "default": "./dist/legacy/capabilities.js"
    },
    "./legacy/dns": {
      "workspace-source": "./src/legacy/actions/dns/index.ts",
      "default": "./dist/legacy/dns.js"
    },
    "./legacy/events": {
      "workspace-source": "./src/legacy/actions/events/index.ts",
      "default": "./dist/legacy/events.js"
    },
    "./legacy/hca": {
      "workspace-source": "./src/legacy/actions/hca/index.ts",
      "default": "./dist/legacy/hca.js"
    },
    "./legacy/hca/admin": {
      "workspace-source": "./src/legacy/actions/hca/admin/index.ts",
      "default": "./dist/legacy/hca/admin.js"
    },
    "./legacy/indexer": {
      "workspace-source": "./src/legacy/actions/indexer/index.ts",
      "default": "./dist/legacy/indexer.js"
    },
    "./legacy/indexer/history": {
      "workspace-source": "./src/legacy/actions/indexer/history/index.ts",
      "default": "./dist/legacy/indexer/history.js"
    },
    "./legacy/indexer/names": {
      "workspace-source": "./src/legacy/actions/indexer/names/index.ts",
      "default": "./dist/legacy/indexer/names.js"
    },
    "./legacy/indexer/records": {
      "workspace-source": "./src/legacy/actions/indexer/records/index.ts",
      "default": "./dist/legacy/indexer/records.js"
    },
    "./legacy/indexer/registrations": {
      "workspace-source": "./src/legacy/actions/indexer/registrations/index.ts",
      "default": "./dist/legacy/indexer/registrations.js"
    },
    "./legacy/indexer/registries": {
      "workspace-source": "./src/legacy/actions/indexer/registries/index.ts",
      "default": "./dist/legacy/indexer/registries.js"
    },
    "./legacy/indexer/resolvers": {
      "workspace-source": "./src/legacy/actions/indexer/resolvers/index.ts",
      "default": "./dist/legacy/indexer/resolvers.js"
    },
    "./legacy/migration": {
      "workspace-source": "./src/legacy/actions/migration/index.ts",
      "default": "./dist/legacy/migration.js"
    },
    "./legacy/permissions": {
      "workspace-source": "./src/legacy/actions/permissions/index.ts",
      "default": "./dist/legacy/permissions.js"
    },
    "./legacy/storage": {
      "workspace-source": "./src/legacy/storage/index.ts",
      "default": "./dist/legacy/storage.js"
    },
    "./legacy/storage/browser": {
      "workspace-source": "./src/legacy/storage/browser.ts",
      "default": "./dist/legacy/storage/browser.js"
    },
    "./legacy/wagmi": {
      "workspace-source": "./src/legacy/wagmi/index.ts",
      "default": "./dist/legacy/wagmi.js"
    },
    "./legacy/wrapping": {
      "workspace-source": "./src/legacy/actions/wrapping/index.ts",
      "default": "./dist/legacy/wrapping.js"
    },
    "./package.json": "./package.json",
    "./legacy/testing": {
      "workspace-source": "./src/legacy/testing/index.ts",
      "default": "./dist/legacy/testing.js"
    }
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./actions": "./dist/actions.js",
      "./effect": "./dist/effect.js",
      "./legacy": "./dist/legacy.js",
      "./legacy/batch": "./dist/legacy/batch.js",
      "./legacy/capabilities": "./dist/legacy/capabilities.js",
      "./legacy/dns": "./dist/legacy/dns.js",
      "./legacy/events": "./dist/legacy/events.js",
      "./legacy/hca": "./dist/legacy/hca.js",
      "./legacy/hca/admin": "./dist/legacy/hca/admin.js",
      "./legacy/indexer": "./dist/legacy/indexer.js",
      "./legacy/indexer/history": "./dist/legacy/indexer/history.js",
      "./legacy/indexer/names": "./dist/legacy/indexer/names.js",
      "./legacy/indexer/records": "./dist/legacy/indexer/records.js",
      "./legacy/indexer/registrations": "./dist/legacy/indexer/registrations.js",
      "./legacy/indexer/registries": "./dist/legacy/indexer/registries.js",
      "./legacy/indexer/resolvers": "./dist/legacy/indexer/resolvers.js",
      "./legacy/migration": "./dist/legacy/migration.js",
      "./legacy/permissions": "./dist/legacy/permissions.js",
      "./legacy/storage": "./dist/legacy/storage.js",
      "./legacy/storage/browser": "./dist/legacy/storage/browser.js",
      "./legacy/wagmi": "./dist/legacy/wagmi.js",
      "./legacy/wrapping": "./dist/legacy/wrapping.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "api:report": "node ../../scripts/api-report.mjs index effect",
    "build": "tsdown",
    "codegen": "node scripts/codegen/main.ts",
    "codegen:check": "node scripts/codegen/main.ts --check",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./legacy/testing",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "verify": "pnpm codegen:check && node ../../scripts/lint-jsdoc.mjs src/index.ts src/effect.ts && node ../../scripts/api-report.mjs --check index effect && node ../../scripts/check-dist-types.mjs index actions --consumer scripts/fixtures/consumer.ts && typedoc"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "catalog:",
    "@ensdomains/content-hash": "catalog:",
    "@ensforge/contracts": "workspace:*",
    "cborg": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "viem": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "viem": "^2.57.0",
    "wagmi": "^3.7.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  }
}

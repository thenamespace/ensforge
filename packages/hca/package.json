{
  "name": "@ensforge/hca",
  "version": "1.1.0",
  "description": "Hosted Contract Accounts for ENS: one-transaction writes, sessions and gasless execution (experimental)",
  "keywords": [
    "account-abstraction",
    "ens",
    "ensv2",
    "ethereum",
    "ethereum-name-service",
    "hca",
    "names",
    "resolver",
    "sessions",
    "smart-account",
    "viem",
    "web3"
  ],
  "homepage": "https://ensforge.com/docs/hca",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "author": "Namespace Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/hca"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "workspace-source": "./src/effect.ts",
      "default": "./dist/effect.js"
    },
    "./internal/*": {
      "workspace-source": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./effect": "./dist/effect.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "ensforge-dev build",
    "dev": "ensforge-dev build --watch",
    "lint": "oxlint -c ../../.config/oxlint.config.ts --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "verify": "ensforge-dev verify",
    "api:report": "ensforge-dev api-report",
    "codegen": "ensforge-dev codegen"
  },
  "dependencies": {
    "@ensforge/contracts": "workspace:*",
    "@ensforge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@ensforge/tools": "workspace:*",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "viem": "^2.57.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "ensforge": {
    "api": [
      ".",
      "./effect"
    ],
    "effectFree": [
      "."
    ],
    "codegen": "extension"
  }
}

{
  "name": "@ensforge/hca",
  "version": "0.6.1",
  "description": "ENS Hosted Contract Accounts: one-transaction writes, sessions and gasless execution",
  "keywords": [
    "ens",
    "ethereum",
    "name-service",
    "sdk",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://ensforge.com",
  "bugs": "https://github.com/thenamespace/ensforge/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/ensforge.git",
    "directory": "packages/hca"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "workspace-source": "./src/effect.ts",
      "default": "./dist/effect.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./effect": "./dist/effect.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build",
    "codegen": "node ../sdk/scripts/codegen/main.ts --root .",
    "codegen:check": "node ../sdk/scripts/codegen/main.ts --root . --check",
    "verify": "pnpm codegen:check && node ../../scripts/lint-jsdoc.mjs src/index.ts src/effect.ts && node ../../scripts/api-report.mjs --check index effect && node ../../scripts/check-dist-types.mjs index && node ../../scripts/check-examples.mjs scripts/fixtures/example-globals.ts",
    "api:report": "node ../../scripts/api-report.mjs index effect"
  },
  "dependencies": {
    "@ensforge/contracts": "workspace:*",
    "@ensforge/sdk": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ensforge/test-harness": "workspace:*",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4",
    "viem": "^2.57.0"
  }
}

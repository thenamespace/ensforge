{
  "oxc.configPath": ".config/oxlint.config.ts",
  "oxc.fmt.configPath": ".config/oxfmt.config.ts",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "vitest.rootConfig": ".config/vitest.config.ts",
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript/bin",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.additionalLocations": ["./node_modules/typescript/bin"],
  "json.schemas": [
    { "fileMatch": [".config/turbo.json"], "url": "https://turborepo.com/schema.json" }
  ]
}

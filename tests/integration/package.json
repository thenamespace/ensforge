  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@ensforge/contracts": "workspace:*",
    "@ensforge/hca": "workspace:*",
    "@ensforge/sdk": "workspace:*",
    "@ensforge/test-devnet": "workspace:*",
    "@ensforge/test-fixtures": "workspace:*",
    "@ensforge/test-harness": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "viem": "catalog:"
  }
}

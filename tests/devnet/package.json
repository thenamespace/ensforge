{
  "name": "@ensforge/test-devnet",
  "version": "0.0.0",
  "private": true,
  "description": "Local ENS deployment for ensforge's chain test suites (not published)",
  "bin": {
    "ensforge-devnet": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },

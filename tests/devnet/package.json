    "viem": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ensforge/sdk": "workspace:*",
    "@types/node": "catalog:",
    "solc-0.8.25": "catalog:",
    "solc-0.8.27": "catalog:"
  }
}

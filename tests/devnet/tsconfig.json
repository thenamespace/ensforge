{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "customConditions": ["workspace-source"],
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": ".",
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        },
        "keyPatterns": [{ "target": "service", "pattern": "package-identifier" }],
        "allowedUnstableApis": [
          "@effect/vitest",
          "@effect/platform-node",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/cli",
          "effect/http",
          "effect/process"
        ],
        "allowedExperimentalApis": ["@ensforge/hca", "@ensforge/contracts/v2/experimental/hca"]
      }
    ]
  },
  "include": ["src/**/*.ts"]
}

{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "customConditions": ["workspace-source"],
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.ts"]
}

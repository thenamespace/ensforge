{
  "name": "@ensforge/test-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test harness for ensforge test suites (not published)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./setup": "./src/setup.ts",
    "./*": "./src/*.ts"

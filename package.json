{
  "name": "ensforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck build verify && pnpm bundle:size && pnpm test",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "pack:check": "turbo run pack:check",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "test": "vitest run --project \"*:unit\" --project \"*:types\"",
    "test:types": "vitest run --project \"*:types\"",
    "test:unit": "vitest run --project \"*:unit\"",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run verify",
    "version-packages": "changeset version",
    "bundle:size": "node scripts/bundle-size.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "rolldown": "catalog:",
    "tslib": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:",
    "wagmi": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}

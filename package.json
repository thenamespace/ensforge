{
  "name": "ensforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo --root-turbo-json .config/turbo.json run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && turbo --root-turbo-json .config/turbo.json run typecheck build verify && pnpm bundle:size && pnpm test",
    "dev": "turbo --root-turbo-json .config/turbo.json run dev",
    "format": "oxfmt -c .config/oxfmt.config.ts --write .",
    "format:check": "oxfmt -c .config/oxfmt.config.ts --check .",
    "lint": "turbo --root-turbo-json .config/turbo.json run lint",
    "pack:check": "turbo --root-turbo-json .config/turbo.json run pack:check",
    "prepare": "lefthook install && effect-tsgo patch --typescript --no-oxlint",
    "release": "changeset publish",
    "test": "vitest run -c .config/vitest.config.ts --project \"*:unit\" --project \"*:types\"",
    "test:fuzz": "vitest run -c .config/vitest.config.ts --project fuzz",
    "test:chain": "vitest run -c .config/vitest.config.ts --project devnet --project fixtures --project integration",
    "typecheck": "turbo --root-turbo-json .config/turbo.json run typecheck",
    "version-packages": "changeset version",
    "bundle:size": "ensforge-dev bundle-size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@ensforge/test-devnet": "workspace:*",
    "@ensforge/tools": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "rolldown": "catalog:",
    "tslib": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:",
    "wagmi": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}

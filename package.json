{
  "name": "ensforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo --root-turbo-json .config/turbo.json run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && turbo --root-turbo-json .config/turbo.json run typecheck build verify && pnpm bundle:size && pnpm test",
    "ci:check": "pnpm check",
    "dev": "turbo --root-turbo-json .config/turbo.json run dev",
    "format": "oxfmt -c .config/oxfmt.config.ts --write .",
    "format:check": "oxfmt -c .config/oxfmt.config.ts --check .",
    "lint": "turbo --root-turbo-json .config/turbo.json run lint",
    "lint:fix": "turbo --root-turbo-json .config/turbo.json run lint -- --fix",
    "pack:check": "turbo --root-turbo-json .config/turbo.json run pack:check",
    "prepare": "lefthook install && effect-tsgo patch --typescript --oxlint",
    "release": "changeset publish",
    "typecheck": "turbo --root-turbo-json .config/turbo.json run typecheck",
    "version-packages": "changeset version",
    "release:version": "changeset version && pnpm install --lockfile-only && pnpm format",
    "release:prepare": "pnpm check && pnpm test:chain && pnpm test:fuzz && pnpm test:services",
    "release:pack": "pnpm build && changeset pack",
    "release:check": "ensforge-dev release check",
    "release:smoke": "ensforge-dev release smoke",
    "bundle:size": "ensforge-dev bundle-size",
    "test": "vitest run -c .config/vitest.config.ts --project \"*:unit\" --project \"*:types\"",
    "test:chain": "vitest run -c .config/vitest.config.ts --project devnet --project fixtures --project integration",
    "test:fuzz": "vitest run -c .config/vitest.config.ts --project fuzz",
    "test:services": "vitest run -c .config/vitest.config.ts --project services",
    "test:fork": "vitest run -c .config/vitest.config.ts --project fork",
    "test:live": "vitest run -c .config/vitest.config.ts --project live",
    "test:mutation": "stryker run .config/stryker.config.json",
    "test:mutation:chain": "stryker run .config/stryker.chain.config.json",
    "devnet:build": "ensforge-devnet build",
    "devnet:verify": "ensforge-devnet verify",
    "artifacts:check": "ensforge-devnet artifacts check",
    "artifacts:refresh": "ensforge-devnet artifacts refresh",
    "release:watch": "ensforge-devnet artifacts watch && pnpm --filter @ensforge/sdk openapi drift"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@ensforge/test-devnet": "workspace:*",
    "@ensforge/tools": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "rolldown": "catalog:",
    "tslib": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:",
    "wagmi": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}

{
  "name": "ensforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && turbo run typecheck build verify && pnpm test",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts && turbo run lint",
    "lint:fix": "oxlint --fix .",
    "pack:check": "turbo run pack:check",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "test": "vitest run --project \"*:unit\" --project \"*:types\"",
    "test:types": "vitest run --project \"*:types\"",
    "test:unit": "vitest run --project \"*:unit\"",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run verify",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/vitest": "catalog:",
    "@types/node": "26.6.6",
    "effect": "catalog:",
    "klarity": "0.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "publint": "0.3.25",
    "rolldown": "1.3.2",
    "tslib": "2.9.1",
    "turbo": "2.11.11",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "viem": "catalog:",
    "vitest": "catalog:",
    "wagmi": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}

{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": ".config/vitest.mutation-unit.config.ts" },
  "mutate": [
    "packages/sdk/src/internal/write/**/*.ts",
    "packages/sdk/src/internal/action/write.ts",
    "packages/sdk/src/actions/plan/**/*.ts",
    "packages/hca/src/hca.ts",
    "packages/hca/src/executors/*.ts"
  ],
  "ignorePatterns": [
    "/research",
    "/tests/devnet/.cache",
    "/tests/services/.cache",
    "dist",
    ".turbo"
  ],
  "tsconfigFile": "none",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/unit.html" },
  "jsonReporter": { "fileName": "reports/mutation/unit.json" },
  "concurrency": 4,
  "timeoutMS": 60000
}

{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": ".config/vitest.sdk-chain.config.ts" },
  "mutate": ["packages/sdk/src/internal/write/send.ts", "packages/sdk/src/internal/write/via.ts"],
  "ignorePatterns": [
    "/research",
    "/tests/devnet/.cache",
    "/tests/services/.cache",
    "dist",
    ".turbo"
  ],
  "tsconfigFile": "none",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/chain.html" },
  "jsonReporter": { "fileName": "reports/mutation/chain.json" },
  "concurrency": 2,
  "timeoutMS": 120000
}

# Build-time variables. In production they come from the deploy workflow's DOCS_DOTENV secret,
# passed to the Docker build as a secret (apps/docs/Dockerfile).

# Origin for canonical URLs, Open Graph images and the sitemap. Defaults to https://ensforge.com.
VITE_SITE_URL=https://ensforge.com

# Runtime, optional. Raises GitHub's rate limit for the docs changelogs (a fine-grained token with
# public read-only access). Changelogs read GitHub per request, so in production set it on the
# running container's environment; the build's DOCS_DOTENV does not reach the image.
GITHUB_TOKEN=

# PostHog project key (public, starts with phc_). Analytics is off without it, and runs only in
# production builds served from ensforge.com. Put it in .env.local locally.
VITE_POSTHOG_KEY=
# Optional. PostHog ingestion host, e.g. a managed reverse proxy. Defaults to https://eu.i.posthog.com.
VITE_POSTHOG_HOST=

# Build only, optional: uploads source maps to PostHog error tracking, then deletes them. Deploy
# builds only (the Docker build sets GIT_SHA). A personal API key with the "error tracking: write"
# and "organization: read" scopes (plus "annotation: write" for the deploy's release annotation),
# and the PostHog project id; both are required for the upload.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

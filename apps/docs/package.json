{
  "name": "@ensforge/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=6144' vocs build",
    "dev": "vocs dev --port 3000",
    "lint": "oxlint --deny-warnings components pages examples snippets/hca/guides server sidebar.ts vite.config.ts vocs.config.ts",
    "preview": "vocs preview --port 3000",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.hca-guides.json",
    "example:hca:local": "tsx examples/hca/local.ts",
    "example:hca:pimlico": "tsx --env-file=.env.hca examples/hca/pimlico.ts",
    "example:hca:rhinestone": "tsx --env-file=.env.hca examples/hca/rhinestone.ts"
  },
  "dependencies": {
    "@ensforge/core": "workspace:*",
    "@ensforge/sdk": "workspace:*",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.102.8",
    "@thenamespace/uikit": "0.3.0",
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "@x402/extensions": "^2.24.0",
    "@x402/svm": "^2.24.0",
    "effect": "catalog:",
    "posthog-js": "^1.427.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tslib": "2.8.1",
    "viem": "catalog:",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@ensforge/contracts": "workspace:*",
    "@ensforge/hca": "workspace:*",
    "@ensforge/react": "workspace:*",
    "@ensforge/test-env": "workspace:*",
    "@rhinestone/sdk": "1.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "permissionless": "0.4.0",
    "react-server-dom-webpack": "~19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "vite": "catalog:",
    "vocs": "2.8.1",
    "waku": "1.0.0-beta.6"
  }
}
